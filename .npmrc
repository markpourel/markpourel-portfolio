# Настройки npm для контейнерной сборки и CI.
# Сеть внутри Docker бывает медленной и нестабильной; без повторов npm ci
# молча выбрасывает optional-пакеты (например, нативный @next/swc-*-musl),
# после чего next build пытается скачать бинарь и падает.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
