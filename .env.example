# Публичный адрес сайта. Используется в metadata, canonical и OG.
# На проде — собственный домен; после смены значения нужен передеплой,
# потому что NEXT_PUBLIC_* вшивается в клиентский бандл на сборке.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Форма контактов — настраивается на этапе 7.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Метаданные сборки: подставляется CI/Dockerfile, локально — dev.
GIT_SHA=dev
